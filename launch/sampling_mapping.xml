<launch>

<!-- Launch robot perception node, to read Giraff rosbags and map with urcentainity poses-->

	 

	<node pkg="voxeland_robot_perception" exec="robot_sampling_pose.py" name="pose_sampler" launch-prefix="xterm -e">

		<!-- Topics and Services -->
		<param name="topic_pose_to_sample" value="/pose_to_sample" />

		<!-- Mapping parameters -->
		<param name="n_samples" value="20" />

		<!-- Output configuration --> 
		<param name="sampling_results" value="cloud_in" />
		<param name="sampled_pose_echo" value="sampled_pose" />

	</node>

	<!--node pkg="rviz2" exec="rviz2" name="rviz2" output="screen" args="-d $(find-pkg-share voxeland_robot_perception)/rviz/rgbd_nn_map.rviz"/-->

</launch>
